  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "typo": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test src apps/website resources",
    "typecheck": "tsc -p tsconfig.json",
    "docs:rules": "bun scripts/gen-rules-doc.ts",
    "docs:sources": "bun resources/gen-sources.ts",
    "docs:languages": "bun scripts/gen-languages-doc.ts",
    "gen:script": "bun scripts/gen-hang-script.ts",
    "compare": "bun scripts/compare-engines.ts",
    "snapshot": "bun scripts/update-snapshot.ts",
    "website": "vite --config apps/website/vite.config.ts",
    "website:build": "vite build --config apps/website/vite.config.ts",
    "site:images": "bun scripts/site-images.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
