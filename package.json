{
  "name": "@mokhniuk/typography",
  "version": "0.16.0",
  "type": "module",
  "description": "Typography for running text: quotation by language and register, dashes, non-breaking spaces, measured hanging punctuation.",
  "homepage": "https://typography.mokhni.uk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mokhniuk/typography.git"
  },
  "keywords": [
    "typography",
    "quotes",
    "dashes",
    "nbsp",
    "hanging-punctuation",
    "i18n"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "default": "./dist/html/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./rehype": {
      "types": "./dist/rehype/index.d.ts",
      "default": "./dist/rehype/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "typo": "./dist/cli/main.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "react": "^19.0.0",
    "react-dom": "19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.1"
  }
}
