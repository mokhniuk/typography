{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "apps/playground/**",
      "scripts/**",
      "resources/**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.json",
      "!**/*.md",
      "!src/dom/script.ts",
      "!resources/*.html"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" },
      "style": { "noDescendingSpecificity": "off" },
      "suspicious": { "noTemplateCurlyInString": "off" }
    }
  }
}
